SCAM_SNIFFER_ENVIRONMENT=development
SCAM_SNIFFER_LOG_LEVEL=INFO
SCAM_SNIFFER_DATABASE_URL=postgresql://scam_sniffer:scam_sniffer@localhost:5432/scam_sniffer
SCAM_SNIFFER_BINANCE_REST_URL=https://fapi.binance.com
SCAM_SNIFFER_BINANCE_WS_URL=wss://fstream.binance.com/ws
SCAM_SNIFFER_DEFAULT_SYMBOL=BTCUSDT
SCAM_SNIFFER_BASE_TIMEFRAME=5m
SCAM_SNIFFER_OLLAMA_URL=http://127.0.0.1:11434
SCAM_SNIFFER_QWEN_MODEL=qwen3:14b-q4_K_M
SCAM_SNIFFER_GEMMA_MODEL=gemma3:4b-it-q4_K_M
SCAM_SNIFFER_LLM_ENABLED=false
SCAM_SNIFFER_SIGNAL_GENERATION_ENABLED=false
SCAM_SNIFFER_LIVE_EXECUTION_ENABLED=false
